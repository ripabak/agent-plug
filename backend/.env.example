DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent-plug
# VECTOR_DB_URL diturunkan dari DATABASE_URL (asyncpg -> psycopg). Set hanya
# jika vector store harus menunjuk ke DB lain. Membutuhkan extension pgvector.
# VECTOR_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent-plug
SECRET_KEY=change-me

# Platform admin (read-only monitoring console di /admin). Kosongkan keduanya
# untuk menonaktifkan akses admin. Login via email+password ini (bukan akun user).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Fallback model saat model utama error/rate-limit (comma-separated, opsional)
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b
BACKEND_PUBLIC_URL=http://localhost:8000

# Berapa source yang di-index BERSAMAAN (server-wide). Sisanya mengantri
# (status "Queued" di dashboard) — bulk add lebih lama tapi tidak membebani
# server/rate-limit embedding. Naikkan untuk throughput, turunkan kalau
# embedding API sering rate-limit.
INDEX_CONCURRENCY=3

# read_current_page: max karakter teks halaman yang dikirim ke model per panggilan
PAGE_CONTEXT_MAX_CHARS=10000

# --- Storage (PDF yang di-upload) ---
# local = filesystem (default, UPLOAD_DIR); s3 = S3 EKSTERNAL (SeaweedFS/MinIO/AWS)
# Isi S3_ENDPOINT_URL + kredensial dengan milik Anda saat STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agent-plug
S3_PREFIX=

# --- Agent avatar (photo/logo) ---
# Upload dicek di FE + BE; lalu dikompres ke WebP (Pillow) sebelum disimpan.
# GIF animasi didukung -> WebP animasi; transparansi PNG/GIF dipertahankan.
AVATAR_MAX_SIZE=5242880        # 5 MB raw upload
AVATAR_MAX_DIM=512             # sisi terpanjang setelah resize
AVATAR_MAX_PIXELS=25000000     # guard decode (anti decompression bomb)
AVATAR_MAX_FRAMES=200          # batas frame untuk GIF animasi
AVATAR_QUALITY=82              # kualitas WebP
