# Agent-Plug — Docker Compose environment (root .env)
#
# Copy to `.env` next to docker-compose.yml and adjust. All values here are
# optional — the compose file falls back to these same defaults if unset.
#
# Backend secrets (OPENROUTER_API_KEY, OPENROUTER_MODEL, ...) are NOT read
# from here: they come from `backend/.env` (copy backend/.env.example).

# --- Database (used by both the db service and the backend's DATABASE_URL) ---
# Optional for local dev — the db container only listens on 127.0.0.1:5433 and
# the compose network is internal. Only needed for public deployments.
# ⚠️ Must be set BEFORE the first `docker compose up` (Postgres only reads it
# when the pgdata volume is first initialized). Changing it later requires
# `ALTER USER` or wiping the volume.
POSTGRES_PASSWORD=postgres

# --- Backend ---
# JWT signing secret — generate one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production
# OpenRouter key (optional here; backend/.env takes precedence for this one)
OPENROUTER_API_KEY=
# Comma-separated origins allowed by CORS (dashboard + any widget test pages)
CORS_ORIGINS=http://localhost:5173
# Public base URL used to build the embed snippet / widget script URL
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Frontend (baked into the dashboard at build time) ---
VITE_API_BASE=http://localhost:8000
