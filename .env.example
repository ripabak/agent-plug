# Agent-Plug — environment untuk Docker Compose (root .env)
#
#   cp .env.example .env
#   # isi OPENROUTER_API_KEY (wajib untuk chat & indexing), lalu:
#   docker compose up --build
#
# Semua variabel di bawah ini di-interpolasi oleh docker-compose.yml
# (backend + db + frontend). Setiap variabel punya default — hanya yang kamu
# tulis di sini yang menimpa default tersebut.
#
# Catatan: backend/.env dan frontend/.env TIDAK dibaca oleh Docker — itu hanya
# untuk dev lokal (uv run / bun dev).

# ===================== Database =====================
# Dipakai db service & DATABASE_URL backend.
# Opsional untuk dev lokal (db hanya listen 127.0.0.1:5433). Wajib untuk
# deploy publik. ⚠️ Harus diset SEBELUM `docker compose up` pertama
# (Postgres cuma membaca saat volume pgdata di-init pertama kali).
POSTGRES_PASSWORD=postgres

# ===================== Backend =====================
# JWT signing secret — generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

# Platform admin (read-only monitoring console di /admin). Kosongkan keduanya
# untuk menonaktifkan akses admin. Login via email+password ini (bukan akun user).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
# Origin yang diizinkan CORS (dashboard + halaman tes widget), dipisah koma
CORS_ORIGINS=http://localhost:5173
# Base URL publik untuk embed snippet / widget script
BACKEND_PUBLIC_URL=http://localhost:8000

# OpenRouter — WAJIB untuk chat & indexing (isi key-nya)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b

# Berapa source yang di-index BERSAMAAN (server-wide). Sisanya mengantri
# (status "Queued" di dashboard) — bulk add lebih lama tapi tidak membebani
# server/rate-limit embedding. Naikkan untuk throughput, turunkan kalau
# embedding API sering rate-limit.
INDEX_CONCURRENCY=3

# read_current_page: max karakter teks halaman yang dikirim ke model per panggilan
PAGE_CONTEXT_MAX_CHARS=10000

# ===================== Storage (PDF yang di-upload) =====================
# local = filesystem (volume `uploads`); s3 = S3 EKSTERNAL (SeaweedFS/MinIO/AWS).
# Pakai S3 eksternal: STORAGE_BACKEND=s3 + isi S3_ENDPOINT_URL & kredensial
# Anda (tidak ada object storage yang di-host di docker-compose).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agent-plug
S3_PREFIX=

# ===================== Frontend =====================
# Base URL API backend, dibakar saat build dashboard
VITE_API_BASE=http://localhost:8000
